# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_SOURCE_CHAT_ID=-1001234567890
# Empty means no one can relay messages until their IDs are added.
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# MAX
MAX_BOT_TOKEN=replace_me
# Legacy pair destination. Once imported, route changes are made in the database.
MAX_TARGET_CHAT_ID=-1234567890
MAX_ALLOWED_USER_IDS=123456789,987654321

MAX_WEBHOOK_URL=https://your-domain.example/max/webhook
MAX_WEBHOOK_SECRET=replace_with_a_long_random_value
APP_PORT=3600
LOG_LEVEL=info
# Technical metadata only; message contents and login secrets are not logged.
# Path inside the container. The host file is ./logs/bridge.log.txt.
LOG_FILE=/app/logs/bridge.log.txt

# Persistent SQLite volume shared by bridge and admin.
DATABASE_PATH=/app/data/bridge.sqlite
# Admin panel is routed through HTTPS Caddy; this internal port is not public.
ADMIN_PORT=3700
ADMIN_WEB_URL=https://admin.example.ru
# Empty list disables web login. Use Telegram numeric user IDs only.
ADMIN_TELEGRAM_USER_IDS=123456789
