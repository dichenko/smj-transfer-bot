# Replace your-domain.example with the domain configured in MAX_WEBHOOK_URL.
# Add this site block to the shared Caddyfile on the VPS.
# Caddy obtains and renews the public TLS certificate automatically.
your-domain.example {
	encode zstd gzip

	handle /max/webhook {
		reverse_proxy 127.0.0.1:3600
	}

	handle {
		respond "not found" 404
	}
}

# Separate HTTPS host for the administration UI. Replace with ADMIN_WEB_URL host.
admin.example.ru {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3700
}
